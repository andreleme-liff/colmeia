# Banco (Supabase Postgres). Supabase → Settings → Database → Connection string.
# Use a "Connection pooling" (Transaction mode, porta 6543) — funciona bem em serverless.
# NUNCA aponte o ambiente local para o projeto Supabase de produção: crie um segundo
# projeto gratuito só para desenvolvimento. Sem esta variável o app não sobe.
DATABASE_URL=

# Login via SSO Google Workspace — é o único jeito de entrar.
# 1. Google Cloud Console → APIs & Services → OAuth consent screen → tipo "Internal".
# 2. Credentials → Create OAuth client ID → Web application → Authorized redirect URI:
#    http://localhost:3000/api/auth/google/callback  (dev)
#    https://SEU-DOMINIO/api/auth/google/callback    (produção)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domínio Workspace autorizado a entrar (padrão: getliff.ai)
GOOGLE_ALLOWED_DOMAIN=getliff.ai

# Quem entra como admin na primeira instalação. Sem isso, contas novas entram como
# 'membro' e sem nenhuma área — e ninguém consegue liberar acesso a ninguém.
ADMIN_EMAIL=andre@getliff.ai

# Define como 0 para subir a base vazia, sem o conjunto de demonstração.
SEED_DEMO=1
